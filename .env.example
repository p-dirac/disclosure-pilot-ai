# ── Disclosure Pilot AI — Windows Native Configuration ──────────────────────────
# Copy this file to .env and fill in your values.
#
#   copy .env.example .env
#
# The app now runs natively on Windows (no Podman/containers, no WSL), so
# PostgreSQL and Ollama are just local processes — use localhost/127.0.0.1.
# ─────────────────────────────────────────────────────────────────────────────

# ── Local host (same for PostgreSQL and Ollama) 
DB_HOST=127.0.0.1
OLLAMA_HOST=127.0.0.1

# --- PostgreSQL credentials (running natively on this Windows machine)
# for application connection to database, not for app login
DB_USER=<connect_user>
DB_PASSWORD=<connect_pass>
DB_NAME=postgres
DB_PORT=5432
# --- 1st schema is for financial accounts
# --- 2nd schema is for app login
# DB_OPTIONS=options=-csearch_path%3D<schema1>,<schema2>
DB_OPTIONS=options=-csearch_path%3Dbookkeeper,applogins

# Constructed automatically by app.core.config — do not edit this line:
# DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?${DB_OPTIONS}

# ── Ollama settings (running natively on this Windows machine)
OLLAMA_PORT=11434
OLLAMA_MODEL=<model>
#
# CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
#
# ─── JWT Security ──────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=1234567890abcdef
#
# Application IO directory
WIN_APPIO_DIR=C:\AppIO
# User input directory — settings.DATA_USER_INPUT_DIR is read directly by
# docx_service.py, so this must be the real Windows path 
DATA_USER_INPUT_DIR=${WIN_APPIO_DIR}\user_input

# Data SEC 10-K directories 
# Data SEC 10-Q directories 
#
# Data SEC 10-K directories — settings.DATA_10K_* is what docx_service.py
# actually reads. 
DATA_10K_DIR=${WIN_APPIO_DIR}\sec10k
DATA_10K_INTRO=${DATA_10K_DIR}\intro
DATA_10K_PART1=${DATA_10K_DIR}\part1
DATA_10K_PART2=${DATA_10K_DIR}\part2
DATA_10K_PART3=${DATA_10K_DIR}\part3
DATA_10K_PART4=${DATA_10K_DIR}\part4
DATA_10K_SIGS=${DATA_10K_DIR}\sigs
#
# Data SEC 10-Q directories, to allow for q1,q2,q3
BASE_10Q = ${WIN_APPIO_DIR}\sec10q-q
DATA_10Q_INTRO=intro
DATA_10Q_PART1=part1
DATA_10Q_PART2=part2
DATA_10Q_SIGS=sigs
#
# Reports output directory — settings.REPORTS_DIR
REPORTS_DIR=${WIN_APPIO_DIR}\reports