# ── Disclosure Pilot AI — Windows Host Configuration ────────────────────────────────
# Copy this file to .env and fill in your values.
#
#   copy .env.windows .env
#
# Find your Windows LAN IP:
#   ipconfig | findstr /i "IPv4"
# Use the 192.168.x.x or 10.x.x.x address — NOT 127.0.0.1 or 169.254.x.x
# ─────────────────────────────────────────────────────────────────────────────

# ── Windows host LAN IP (same for PostgreSQL and Ollama) 
DB_HOST=192.168.x.x
OLLAMA_HOST=192.168.x.x

# --- PostgreSQL credentials (running on Windows 11 host)
DB_USER=user_10qk
DB_PASSWORD=<pass>
DB_NAME=postgres
DB_PORT=5432
# --- 1st schema is for financial accounts
# --- 2nd schema is for application login info
DB_OPTIONS=options=-csearch_path%3D<schema1>,<schema2>

# Constructed automatically by docker-compose.yml — do not edit this line:
# DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?${DB_OPTIONS}

# ── Ollama settings (running on Windows 11 host)
OLLAMA_PORT=11434
OLLAMA_MODEL=<model>
#
# CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
#
# User input directory on Windows host 
WIN_INPUT_DIR=C:\AppIO\user_input
# User input directory inside the container
DATA_INPUT_DIR=/tmp/appio/user_input
#
# Data SEC 10-K directories on Windows host 
WIN_10K_DIR=C:\AppIO\sec10k
WIN_10K_INTRO=C:\AppIO\sec10k\intro
WIN_10K_PART1=C:\AppIO\sec10k\part1
WIN_10K_PART2=C:\AppIO\sec10k\part2
WIN_10K_PART3=C:\AppIO\sec10k\part3
WIN_10K_PART4=C:\AppIO\sec10k\part4
WIN_10K_SIGS=C:\AppIO\sec10k\sigs
#
# Data SEC 10-Q directories on Windows host 
WIN_10Q_DIR=C:\AppIO\sec10q
WIN_10Q_INTRO=C:\AppIO\sec10q\intro
WIN_10Q_PART1=C:\AppIO\sec10q\part1
WIN_10Q_PART2=C:\AppIO\sec10q\part2
WIN_10Q_SIGS=C:\AppIO\sec10q\sigs
#
# Data SEC 10-K directories inside the container
DATA_10K_DIR=/tmp/appio/sec10k
DATA_10K_INTRO=/tmp/appio/sec10k/intro
DATA_10K_PART1=/tmp/appio/sec10k/part1
DATA_10K_PART2=/tmp/appio/sec10k/part2
DATA_10K_PART3=/tmp/appio/sec10k/part3
DATA_10K_PART4=/tmp/appio/sec10k/part4
DATA_10K_SIGS=/tmp/appio/sec10k/sigs
#
# Data SEC 10-Q directories inside the container
DATA_10Q_DIR=/tmp/appio/sec10q
DATA_10Q_INTRO=/tmp/appio/sec10q/intro
DATA_10Q_PART1=/tmp/appio/sec10q/part1
DATA_10Q_PART2=/tmp/appio/sec10q/part2
DATA_10Q_SIGS=/tmp/appio/sec10q/sigs
#
# Reports output directory on Windows host 
WIN_REPORTS_DIR=C:\AppIO\reports
#
# Reports output directory inside the container
REPORTS_DIR=/tmp/appio/reports
